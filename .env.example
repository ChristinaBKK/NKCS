# ============================================
# UC Dashboard - 环境变量配置
# 复制本文件为 .env 并填入实际值
# ============================================

# Supabase 项目 URL（在 Supabase Dashboard → Settings → API 找）
SUPABASE_URL=https://your-project.supabase.co

# 公开 anon key（只读，配合 RLS）—— 公网部署必须用这个
# 在 Supabase Dashboard → Settings → API → Project API keys → "anon public"
SUPABASE_ANON_KEY=eyJ...你的 anon key

# service_role key（admin 权限）—— 仅本地调试用
# 公网部署时建议留空，避免泄漏
SUPABASE_SERVICE_KEY=
